---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/vazirmatn';
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import { profile, asset, plain, current } from '../lib/profile';

const { basics } = profile;
const now = current();
const title = `${basics.name} — ${basics.headline}`;
const description = plain(basics.intro);

// Machine-readable identity for search engines and AI agents.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: basics.name,
  alternateName: basics.name_fa,
  jobTitle: now.title,
  worksFor: { '@type': 'Organization', name: now.company, url: profile.work[0].url },
  url: basics.website,
  email: `mailto:${basics.email}`,
  homeLocation: { '@type': 'Place', name: basics.location },
  sameAs: basics.profiles.map((p) => p.url),
  knowsAbout: profile.skills.flatMap((s) => s.keywords).slice(0, 30),
  alumniOf: profile.education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.institution })),
  knowsLanguage: profile.languages.map((l) => l.language),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={basics.name} />
    <link rel="canonical" href={basics.website} />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href={asset('/llms.txt')} title="llms.txt" />
    <link rel="alternate" type="application/json" href={asset('/resume.json')} title="JSON Resume" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={basics.website} />
    <meta name="theme-color" content="#efebe4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1120" media="(prefers-color-scheme: dark)" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Apply a saved theme before first paint; without one, CSS follows the OS.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
